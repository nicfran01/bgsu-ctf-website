# Copy this file to .env.local for `npm run dev`. .env.local is ignored by git.
# On Vercel, set the same two variables under Settings > Environment Variables.

# The part after https://discord.gg/ in the invite link.
DISCORD_INVITE_CODE=
# Signs the captcha challenges. Any random string of 32 or more characters:
#   openssl rand -hex 32
ALTCHA_HMAC_SECRET=
